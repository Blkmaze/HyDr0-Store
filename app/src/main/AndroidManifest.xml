<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets the store see which catalog apps are already installed (Android 11+). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Runs on TV boxes and phones alike. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/StoreTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands downloaded APK files to the system installer. -->
        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apks"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
