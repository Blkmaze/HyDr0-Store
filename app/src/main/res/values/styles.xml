<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#07090D</color>
    <color name="panel">#0E1218</color>
    <color name="card">#11151C</color>
    <color name="card_border">#222A36</color>
    <color name="accent_dim">#1A00B4FF</color>
    <color name="accent_line">#6600B4FF</color>
    <color name="glow">#3300B4FF</color>
    <color name="pill_muted_bg">#1C222C</color>
    <color name="accent">#00B4FF</color>
    <color name="text">#F2F5FA</color>
    <color name="muted">#8A96AD</color>
    <color name="ok">#3DDC84</color>
    <color name="warn">#FFB020</color>

    <style name="StoreTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
