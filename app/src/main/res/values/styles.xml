<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0B1220</color>
    <color name="panel">#131C2E</color>
    <color name="card">#1A2438</color>
    <color name="accent">#00B4FF</color>
    <color name="text">#F2F5FA</color>
    <color name="muted">#8A96AD</color>
    <color name="ok">#3DDC84</color>
    <color name="warn">#FFB020</color>

    <style name="StoreTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/panel</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/focus_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
