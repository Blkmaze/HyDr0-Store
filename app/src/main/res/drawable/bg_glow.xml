<?xml version="1.0" encoding="utf-8"?>
<!-- Screen background: near-black with a soft blue glow bleeding in from the edges. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="0.0"
                android:gradientRadius="70%p"
                android:startColor="@color/glow"
                android:endColor="#0000B4FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="1.0"
                android:gradientRadius="70%p"
                android:startColor="@color/glow"
                android:endColor="#0000B4FF" />
        </shape>
    </item>
</layer-list>
