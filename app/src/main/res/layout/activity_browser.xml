<?xml version="1.0" encoding="utf-8"?>
<!-- Built-in browser: button bar and address box on top, page below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:text="Back" />

        <Button
            android:id="@+id/btnForward"
            style="@style/TopButton"
            android:text="Forward" />

        <Button
            android:id="@+id/btnReload"
            style="@style/TopButton"
            android:text="Reload" />

        <Button
            android:id="@+id/btnHome"
            style="@style/TopButton"
            android:text="Home" />

        <EditText
            android:id="@+id/address"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/focus_bg"
            android:hint="Type a web address or search"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:selectAllOnFocus="true"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGo"
            style="@style/TopButton"
            android:text="Go" />

        <Button
            android:id="@+id/btnClose"
            style="@style/TopButton"
            android:text="Store" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/accent"
        android:visibility="gone" />

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
