<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen: top bar, category list on the left, app grid on the right.
     The padding keeps everything inside the TV-safe area. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glow"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:background="@drawable/focus_bg"
            android:hint="Search apps"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnUpdateStore"
            style="@style/TopButton"
            android:text="Update store"
            android:textColor="@color/warn"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnBrowser"
            style="@style/TopButton"
            android:text="Browser" />

        <Button
            android:id="@+id/btnCode"
            style="@style/TopButton"
            android:text="Enter code" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/TopButton"
            android:text="Refresh" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:text="Settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ListView
            android:id="@+id/categories"
            android:layout_width="190dp"
            android:layout_height="match_parent"
            android:background="@drawable/card_bg"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:listSelector="@drawable/grid_selector"
            android:drawSelectorOnTop="true"
            android:padding="8dp" />

        <GridView
            android:id="@+id/grid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:columnWidth="230dp"
            android:drawSelectorOnTop="true"
            android:horizontalSpacing="14dp"
            android:listSelector="@drawable/grid_selector"
            android:numColumns="auto_fit"
            android:padding="4dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="14dp" />
    </LinearLayout>
</LinearLayout>
